        <di:waypoint x="300" y="167" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="450" y="167" />
        <di:waypoint x="500" y="167" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="650" y="167" />
        <di:waypoint x="700" y="167" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PublishOk_di" bpmnElement="Flow_PublishOk">
        <di:waypoint x="750" y="167" />
        <di:waypoint x="975" y="167" />
        <di:waypoint x="975" y="302" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="759" y="145" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
