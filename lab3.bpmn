<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_KnowledgeControl" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Company" name="Организация" processRef="Process_KnowledgeControl" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KnowledgeControl" name="Контроль знаний сотрудников" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Admin" name="Администратор">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestValid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Руководитель">
        <bpmn:flowNodeRef>EndEvent_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NotStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResultOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleTraining</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Сотрудник">
        <bpmn:flowNodeRef>Task_TakeTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ViewResult</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Timer3Days</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_ScheduleTraining" name="Назначить дополнительное&#10;обучение и повторный тест">
      <bpmn:incoming>Flow_NeedTraining</bpmn:incoming>
      <bpmn:outgoing>Flow_Retake</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Success" name="Компетенции подтверждены">
      <bpmn:incoming>Flow_End_Ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_ResultOk" name="Результат удовлетворителен?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedTraining</bpmn:outgoing>
      <bpmn:outgoing>Flow_End_Ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_NeedTraining" name="Нет" sourceRef="Gateway_ResultOk" targetRef="Task_ScheduleTraining" />
    <bpmn:sequenceFlow id="Flow_End_Ok" name="Да" sourceRef="Gateway_ResultOk" targetRef="EndEvent_Success" />
    <bpmn:sequenceFlow id="Flow_Retake" sourceRef="Task_ScheduleTraining" targetRef="Task_Notify" />
    <bpmn:userTask id="Task_AnalyzeResults" name="Проанализировать результаты">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_AnalyzeResults" targetRef="Gateway_ResultOk" />
    <bpmn:userTask id="Task_Escalate" name="Эскалация: связаться&#10;с сотрудником">
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_EscalateEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_NotStarted" name="Сотрудник не приступил&#10;к тестированию">
      <bpmn:incoming>Flow_EscalateEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EscalateEnd" sourceRef="Task_Escalate" targetRef="EndEvent_NotStarted" />
    <bpmn:intermediateCatchEvent id="Event_WaitEmployee" name="Ожидание отклика&#10;сотрудника">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_5b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_5b" sourceRef="Event_WaitEmployee" targetRef="Task_TakeTest" />
    <bpmn:boundaryEvent id="Event_Timer3Days" name="3 дня истекли" attachedToRef="Event_WaitEmployee">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Timer" name="Просрочено" sourceRef="Event_Timer3Days" targetRef="Task_Escalate" />
    <bpmn:userTask id="Task_ViewResult" name="Ознакомиться с результатом">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Analyze</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Analyze" sourceRef="Task_ViewResult" targetRef="Task_BuildReport" />
    <bpmn:userTask id="Task_TakeTest" name="Пройти тест">
      <bpmn:incoming>Flow_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_TakeTest" targetRef="Task_AutoCheck" />
    <bpmn:serviceTask id="Task_BuildReport" name="Сформировать отчёт&#10;(графики, экспорт)">
      <bpmn:incoming>Flow_Analyze</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_BuildReport" targetRef="Task_AnalyzeResults" />
    <bpmn:serviceTask id="Task_SaveResult" name="Сохранить результат&#10;в базе данных">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SaveResult" targetRef="Task_ViewResult" />
    <bpmn:serviceTask id="Task_AutoCheck" name="Автоматически проверить ответы">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AutoCheck" targetRef="Task_SaveResult" />
    <bpmn:sendTask id="Task_Notify" name="Отправить уведомление&#10;сотрудникам">
      <bpmn:incoming>Flow_Retake</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Notify" targetRef="Event_WaitEmployee" />
    <bpmn:userTask id="Task_AssignTest" name="Назначить тестирование&#10;(сотрудники, срок)">
      <bpmn:incoming>Flow_PublishOk</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AssignTest" targetRef="Task_Notify" />
    <bpmn:exclusiveGateway id="Gateway_TestValid" name="Тест корректен?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_PublishFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PublishOk" name="Да" sourceRef="Gateway_TestValid" targetRef="Task_AssignTest" />
    <bpmn:serviceTask id="Task_PublishTest" name="Проверить и опубликовать тест">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PublishTest" targetRef="Gateway_TestValid" />
    <bpmn:userTask id="Task_CreateTest" name="Создать тест:&#10;вопросы, типы, критерии">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateTest" targetRef="Task_PublishTest" />
    <bpmn:endEvent id="EndEvent_Error" name="Тест не опубликован">
      <bpmn:incoming>Flow_PublishFail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PublishFail" name="Нет" sourceRef="Gateway_TestValid" targetRef="EndEvent_Error" />
    <bpmn:startEvent id="StartEvent_1" name="Старт: потребность в оценке знаний">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CreateTest" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="3108" height="700" />
      </bpmndi:BPMNShape>
