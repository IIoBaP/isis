        <dc:Bounds x="3092" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3072" y="335" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScheduleTraining_di" bpmnElement="Task_ScheduleTraining">
        <dc:Bounds x="2915" y="340" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Timer3Days_di" bpmnElement="Event_Timer3Days">
        <dc:Bounds x="1418" y="656" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1335" y="640" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
