<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Registration" name="Регистрация пользователя" isExecutable="false">

    <!-- Стартовое событие -->
    <bpmn:startEvent id="StartEvent_1" name="Начало регистрации">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Задача пользователя: ввод данных -->
    <bpmn:userTask id="Task_EnterData" name="Ввести данные&#10;(имя, email, пароль)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Сервисная задача: проверка данных -->
    <bpmn:serviceTask id="Task_ValidateData" name="Проверить корректность данных">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Шлюз: данные корректны? -->
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Данные корректны?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Сервисная задача: отправка письма -->
    <bpmn:serviceTask id="Task_SendEmail" name="Отправить письмо&#10;для подтверждения">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Задача пользователя: подтверждение -->
    <bpmn:userTask id="Task_Confirm" name="Подтвердить регистрацию&#10;(перейти по ссылке из письма)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Конечное событие: успех -->
    <bpmn:endEvent id="EndEvent_Success" name="Регистрация успешна">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Конечное событие: ошибка валидации -->
    <bpmn:endEvent id="EndEvent_Error" name="Регистрация отклонена&#10;(некорректные данные)">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Потоки управления -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_EnterData" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_EnterData" targetRef="Task_ValidateData" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ValidateData" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Да" sourceRef="Gateway_Valid" targetRef="Task_SendEmail" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="Нет" sourceRef="Gateway_Valid" targetRef="EndEvent_Error" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SendEmail" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Confirm" targetRef="EndEvent_Success" />
  </bpmn:process>

  <!-- Диаграммная информация (координаты и размеры) -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Registration">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="245" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_EnterData_di" bpmnElement="Task_EnterData">
        <dc:Bounds x="240" y="180" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidateData_di" bpmnElement="Task_ValidateData">
        <dc:Bounds x="420" y="180" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="605" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="165" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendEmail_di" bpmnElement="Task_SendEmail">
        <dc:Bounds x="700" y="180" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm">
        <dc:Bounds x="880" y="180" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="1072" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1045" y="245" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Error_di" bpmnElement="EndEvent_Error">
        <dc:Bounds x="612" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="580" y="393" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="370" y="220" />
        <di:waypoint x="420" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="550" y="220" />
        <di:waypoint x="605" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="655" y="220" />
        <di:waypoint x="700" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="672" y="198" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="630" y="245" />
        <di:waypoint x="630" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="636" y="290" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="830" y="220" />
        <di:waypoint x="880" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1020" y="220" />
        <di:waypoint x="1072" y="220" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>