        <dc:Bounds x="2250" y="477" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_WaitEmployee_di" bpmnElement="Event_WaitEmployee">
        <dc:Bounds x="1400" y="674" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1372" y="717" width="96" height="27" />
